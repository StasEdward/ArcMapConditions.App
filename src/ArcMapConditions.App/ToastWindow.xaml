<Window x:Class="ArcMapConditions.App.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ARC Raiders — reminder"
        Width="320"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True">

    <Border Margin="10" CornerRadius="12"
            Background="{StaticResource ShellBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.6" Color="#000000" />
        </Border.Effect>

        <Grid Margin="14,12,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="9"
                    Background="#22000000" Margin="0,0,12,0" VerticalAlignment="Top">
                <Image x:Name="IconImage" Width="32" Height="32"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="EVENT STARTED" Style="{StaticResource EyebrowText}" />
                <TextBlock x:Name="TitleText" Style="{StaticResource RowTitleText}"
                           Margin="0,2,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="SubText" Style="{StaticResource RowTimeUpcomingText}"
                           Margin="0,3,0,0" />
            </StackPanel>

            <Button Grid.Column="2" Style="{StaticResource ToolButton}" Content="&#xE711;"
                    ToolTip="Dismiss" VerticalAlignment="Top" Click="Dismiss_Click" />
        </Grid>
    </Border>
</Window>
