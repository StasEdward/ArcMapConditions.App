<Window x:Class="ArcMapConditions.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ArcMapConditions.App.ViewModels"
        Title="ARC Map Conditions"
        Icon="app.ico"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <!-- Outer margin leaves room for the drop shadow. -->
    <Border Margin="12"
            CornerRadius="14"
            Background="{StaticResource ShellBrush}"
            BorderBrush="{StaticResource ShellBorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Refresh now" Command="{Binding RefreshCommand}" />
                <MenuItem Header="Open arcraiders.com" Command="{Binding OpenSiteCommand}" />
                <Separator />
                <MenuItem x:Name="PinMenuItem" Header="Always on top"
                          IsCheckable="True" IsChecked="True" Click="PinMenuItem_Click" />
                <MenuItem x:Name="StartupMenuItem" Header="Run at Windows startup"
                          IsCheckable="True" Click="StartupMenuItem_Click" />
                <MenuItem x:Name="RememberPosMenuItem" Header="Remember position"
                          IsCheckable="True" IsChecked="True" Click="RememberPosMenuItem_Click" />
                <Separator />
                <MenuItem Header="Exit" Click="ExitMenuItem_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <StackPanel Margin="16,14,16,14">

            <!-- ============ Header (drag handle) ============ -->
            <Grid x:Name="HeaderBar" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="ARC RAIDERS" Style="{StaticResource EyebrowText}" />
                    <TextBlock Text="MAP CONDITIONS" Style="{StaticResource TitleText}" Margin="0,1,0,0" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusText}" Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Top" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ToolButton}" Content="&#xE72C;"
                            ToolTip="Refresh now" Command="{Binding RefreshCommand}" />
                    <Button Style="{StaticResource ToolButton}" Content="&#xE71B;"
                            ToolTip="Open arcraiders.com" Command="{Binding OpenSiteCommand}" />
                    <Button x:Name="PinButton" Style="{StaticResource ToolButton}" Content="&#xE840;"
                            ToolTip="Always on top" Click="PinButton_Click" />
                    <Button Style="{StaticResource ToolButton}" Content="&#xE711;"
                            ToolTip="Close" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <!-- ============ Scrollable body ============ -->
            <ScrollViewer x:Name="BodyScroller"
                          Style="{StaticResource OverlayScrollViewer}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="820"
                          Margin="0,10,0,0">
                <StackPanel>

                    <!-- ===== ACTIVE NOW ===== -->
                    <StackPanel Visibility="{Binding HasActive, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ActiveLabel}" Style="{StaticResource SectionLabelText}"
                                   Margin="2,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Active}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ConditionRow}">
                                    <Border Background="{StaticResource ActiveCardBrush}"
                                            BorderBrush="{StaticResource ActiveCardBorderBrush}"
                                            BorderThickness="1" CornerRadius="10"
                                            Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                                    Background="#22000000" Margin="0,0,10,0">
                                                <Image Source="{Binding Icon}" Width="28" Height="28"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitleText}" />
                                                <TextBlock Text="{Binding TimeText}" Style="{StaticResource RowTimeActiveText}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ===== COMING UP ===== -->
                    <TextBlock Text="{Binding UpcomingLabel}" Style="{StaticResource SectionLabelText}"
                               Margin="2,4,0,6" />
                    <ItemsControl ItemsSource="{Binding Upcoming}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ConditionRow}">
                                <Border x:Name="RowCard" Background="{StaticResource CardBrush}"
                                        CornerRadius="9" Padding="9,7" Margin="0,0,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6"
                                                Background="#1A000000" Margin="0,0,9,0">
                                            <Image Source="{Binding Icon}" Width="22" Height="22"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitleSmallText}" />
                                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource RowTimeUpcomingText}"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource BellButton}"
                                                Command="{Binding ToggleSubscribeCommand}"
                                                VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </Grid>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </Border>
</Window>
